# ---------------------------------------------------------------------------
# Alpaca Crypto Trading Bot - environment template
#
#   1. Copy this file to `.env`   ->   copy .env.example .env   (Windows)
#                                      cp .env.example .env     (macOS/Linux)
#   2. Paste your PAPER trading keys from
#      https://app.alpaca.markets/paper/dashboard/overview
#   3. NEVER commit the real `.env` - it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- REQUIRED: Alpaca API credentials --------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Keep this true. Setting it to false points at the LIVE money endpoint.
ALPACA_PAPER=true

# --- OPTIONAL: universe & cadence ------------------------------------------
# Comma separated. Alpaca crypto pairs use a slash, e.g. BTC/USD
WATCHLIST=BTC/USD,ETH/USD,SOL/USD
BAR_TIMEFRAME=15Min
LOOP_INTERVAL_SECONDS=900
BAR_LIMIT=250

# --- OPTIONAL: strategy parameters -----------------------------------------
SMA_PERIOD=200
EMA_PERIOD=20
RSI_PERIOD=14
RSI_BUY_THRESHOLD=42
EMA_PROXIMITY_PCT=0.005

# --- OPTIONAL: exit rules (enforced in Python, not by Alpaca) --------------
TAKE_PROFIT_PCT=0.05
STOP_LOSS_PCT=0.02

# --- OPTIONAL: risk & capital limits ---------------------------------------
MAX_POSITIONS=2
MAX_RISK_PER_TRADE=0.01
MAX_TOTAL_EXPOSURE_PCT=0.20
MIN_NOTIONAL_USD=10
QTY_PRECISION=4

# --- OPTIONAL: order polling ------------------------------------------------
ORDER_POLL_TIMEOUT_SECONDS=60
ORDER_POLL_INTERVAL_SECONDS=2

# --- OPTIONAL: files & logging ---------------------------------------------
# POSITIONS_FILE=positions.json
# LOG_FILE=crypto_bot.log
LOG_LEVEL=INFO
